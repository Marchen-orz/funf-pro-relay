{
  "_comment": "啵啵贝 Pro 协议适配层。已验证：吮吸(07/08)✓ 震动(01/02)✓ 电流(03/04)待确认；产品所称入体与震动为同一功能",
  "_comment2": "Pro 通道与旧版一致！2026-07-12 探测确认",

  "device": {
    "_scan_names_comment": "Pro 抓包确认广播名后追加到这里，如 SOSEXY Pro",
    "scan_names": ["SOSEXY"],
    "rssi_threshold": -90
  },

  "gatt": {
    "_comment": "Pro 抓包确认后如果 UUID 变了，只改这里",
    "service_uuid": "0000ee01-0000-1000-8000-00805f9b34fb",
    "write_uuid": "0000ee03-0000-1000-8000-00805f9b34fb",
    "notify_uuid": "0000ee02-0000-1000-8000-00805f9b34fb",
    "write_with_response": true,
    "use_start_notifications": true,
    "_cccd_comment": "不要手动写 0x2902，新 Android/Chrome 会拦截"
  },

  "frame": {
    "_comment": "帧模板。占位符 [SEQ] [MODE1] [INTENSITY] [MODE2] 运行时被替换",
    "format": "fixed_12",
    "template": ["[SEQ]", "0x01", "0x00", "0x02", "0x00", "[MODE1]", "0x11", "[INTENSITY]", "0x00", "[MODE2]", "0x11", "0x01"],
    "seq_random": true,
    "intensity_range": [0, 100],
    "mode_range": [1, 4]
  },

  "functions": {
    "suction":     {"name": "吮吸",   "mode1": "0x07", "mode2": "0x08", "supports_mode": true},
    "vibration":   {"name": "震动",   "mode1": "0x01", "mode2": "0x02", "supports_mode": true},
    "electric":    {"name": "微电流", "mode1": "0x03", "mode2": "0x04", "supports_mode": true}
  },

  "init_sequence": {
    "_comment": "连接后必发的初始化帧，等设备回 4 条 NOTIFY 分片才算就绪",
    "enabled": true,
    "frame": ["[SEQ]", "0x01", "0x00", "0x01", "0x00", "0xC8", "0x11", "0x01"],
    "notify_fragment_count": 4,
    "wait_notify_ms": 2000
  },

  "send_strategy": {
    "_comment": "逐功能发包：一次只发当前正在调的那一对通道（强度+模式）",
    "per_function_pair": true,
    "_anti_pattern": "不要一次发 6 组通道塞一个包里，设备会无视"
  },

  "stop_strategy": {
    "_comment": "停止 = 向各功能各发一次强度归零（模式保留）",
    "per_function_zero_intensity": true
  },

  "presets": {
    "_comment": "预设场景，网页和 AI 都可调用",
    "calm":    {"name": "温柔", "suction": 20, "vibration": 20, "electric": 0},
    "normal":  {"name": "日常", "suction": 40, "vibration": 40, "electric": 10},
    "intense": {"name": "激烈", "suction": 70, "vibration": 70, "electric": 30},
    "stop":    {"name": "全停", "suction": 0,  "vibration": 0,  "electric": 0}
  }
}
