# 部署时复制为 /etc/funf-relay.env 后填入实际值
# ---- 服务端 ----
FUNF_HOST=127.0.0.1
FUNF_PORT=3870
FUNF_PUBLIC_ORIGIN=https://your-domain.com
FUNF_DB_PATH=/var/lib/funf-relay/funf.db

# ---- 多用户管理员（首次启动必填）----
FUNF_ADMIN_USERNAME=admin
FUNF_ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$replace-salt$replace-hash
FUNF_VAULT_KEY=replace-with-a-fernet-key

# 可选：保留旧版单设备连接。新设备应在 Web 控制台按用户生成独立密钥。
FUNF_API_TOKEN=
FUNF_DEVICE_TOKEN=
